{
  "$schema": "https://schemas.tokens.studio/latest/tokens.json",
  "meta": {
    "name": "Iridescent Terminal",
    "version": "1.1.0",
    "description": "Instrument UI. Iridescence on edges and readouts only. Sentence case in product UI; uppercase is reserved for HUD/display moments."
  },
  "color": {
    "bg": {
      "void":  { "$value": "#000000", "$type": "color", "$description": "Page canvas" },
      "hull":  { "$value": "#0B0E12", "$type": "color", "$description": "App chrome" },
      "panel": { "$value": "#12161C", "$type": "color", "$description": "Cards, sheets" },
      "inset": { "$value": "#07090C", "$type": "color", "$description": "Recessed wells, inputs, screen" },
      "elevated": { "$value": "#181E26", "$type": "color" }
    },
    "metal": {
      "base": { "$value": "#9AA3AE", "$type": "color" },
      "edge": { "$value": "#E8EEF4", "$type": "color" },
      "line": { "$value": "#2A313A", "$type": "color" }
    },
    "text": {
      "primary":   { "$value": "#E8EEF4", "$type": "color" },
      "secondary": { "$value": "#8A93A0", "$type": "color" },
      "tertiary":  { "$value": "#5C6570", "$type": "color" },
      "inverse":   { "$value": "#0B0E12", "$type": "color" }
    },
    "iris": {
      "cyan":    { "$value": "#5CE1FF", "$type": "color" },
      "aqua":    { "$value": "#3DFFD2", "$type": "color" },
      "violet":  { "$value": "#A78BFF", "$type": "color" },
      "magenta": { "$value": "#FF5CC8", "$type": "color" },
      "gold":    { "$value": "#F0C14A", "$type": "color" },
      "lime":    { "$value": "#7CFF6B", "$type": "color" }
    },
    "state": {
      "info":     { "$value": "{color.iris.cyan}", "$type": "color" },
      "success":  { "$value": "{color.iris.lime}", "$type": "color" },
      "warning":  { "$value": "{color.iris.gold}", "$type": "color" },
      "danger":   { "$value": "{color.iris.magenta}", "$type": "color" },
      "disabled": { "$value": "#E8EEF447", "$type": "color" }
    },
    "hud": {
      "grid": { "$value": "#1B2430", "$type": "color" }
    },
    "chart": {
      "grid":      { "$value": "#1B2430", "$type": "color", "$description": "Hairline plot grid" },
      "axis":      { "$value": "#2A313A", "$type": "color", "$description": "Axis lines / bar edges" },
      "tick":      { "$value": "#5C6570", "$type": "color", "$description": "Axis tick text" },
      "primary":   { "$value": "#5CE1FF", "$type": "color", "$description": "Series 1 — iris cyan" },
      "secondary": { "$value": "#F0C14A", "$type": "color", "$description": "Series 2 — gold" },
      "tertiary":  { "$value": "#A78BFF", "$type": "color", "$description": "Series 3 — violet" },
      "danger":    { "$value": "#FF5CC8", "$type": "color", "$description": "Down / error — magenta" },
      "pos":       { "$value": "#3DFFD2", "$type": "color", "$description": "Up / positive — aqua" },
      "segA":      { "$value": "#5CE1FF", "$type": "color", "$description": "Stacked segment 1" },
      "segB":      { "$value": "#A78BFF", "$type": "color", "$description": "Stacked segment 2" },
      "segC":      { "$value": "#3DFFD2", "$type": "color", "$description": "Stacked segment 3" },
      "segD":      { "$value": "#F0C14A", "$type": "color", "$description": "Stacked segment 4" },
      "tipBg":     { "$value": "#12161C", "$type": "color", "$description": "Tooltip panel" },
      "tipBorder": { "$value": "#2A313A", "$type": "color" },
      "tipLabel":  { "$value": "#5CE1FF", "$type": "color" },
      "tipText":   { "$value": "#E8EEF4", "$type": "color" },
      "tipRadius": { "$value": "12px", "$type": "borderRadius" }
    }
  },
  "gradient": {
    "iris": {
      "$type": "color",
      "$value": "linear-gradient(135deg, #5CE1FF 0%, #A78BFF 40%, #FF5CC8 70%, #F0C14A 100%)",
      "$description": "Use on borders, text fill, focus rings. Never as a full-screen fill."
    },
    "irisSoft": {
      "$type": "color",
      "$value": "linear-gradient(135deg, rgba(92,225,255,0.35) 0%, rgba(167,139,255,0.28) 50%, rgba(255,92,200,0.22) 100%)"
    },
    "irisConic": {
      "$type": "color",
      "$value": "conic-gradient(from 210deg, #5CE1FF, #A78BFF, #FF5CC8, #F0C14A, #5CE1FF)"
    }
  },
  "fontFamily": {
    "ui":   { "$value": "Inter Tight, IBM Plex Sans, ui-sans-serif, system-ui, sans-serif", "$type": "fontFamilies", "$description": "Google-Fonts stack chosen for this project" },
    "hud":  { "$value": "Press Start 2P, IBM Plex Mono, ui-monospace, monospace", "$type": "fontFamilies", "$description": "Pixel/HUD display moments only" },
    "mono": { "$value": "IBM Plex Mono, ui-monospace, monospace", "$type": "fontFamilies" }
  },
  "fontWeight": {
    "regular": { "$value": 400, "$type": "fontWeights" },
    "medium":  { "$value": 500, "$type": "fontWeights" },
    "semibold":{ "$value": 600, "$type": "fontWeights" }
  },
  "fontSize": {
    "micro":  { "$value": "10px", "$type": "fontSizes" },
    "caption":{ "$value": "12px", "$type": "fontSizes" },
    "label":  { "$value": "13px", "$type": "fontSizes" },
    "body":   { "$value": "14px", "$type": "fontSizes" },
    "bodyLg": { "$value": "16px", "$type": "fontSizes" },
    "title":  { "$value": "20px", "$type": "fontSizes" },
    "display":{ "$value": "40px", "$type": "fontSizes" }
  },
  "letterSpacing": {
    "ui":  { "$value": "0", "$type": "letterSpacing" },
    "hud": { "$value": "0.08em", "$type": "letterSpacing" }
  },
  "textCase": {
    "ui":      { "$value": "none", "$type": "textCase", "$description": "Sentence case for all product UI" },
    "hud":     { "$value": "uppercase", "$type": "textCase", "$description": "Only hero/HUD readouts" },
    "status":  { "$value": "uppercase", "$type": "textCase", "$description": "Optional 10–11px status chips only" }
  },
  "lineHeight": {
    "tight": { "$value": "1.2", "$type": "lineHeights" },
    "body":  { "$value": "1.45", "$type": "lineHeights" }
  },
  "space": {
    "2":  { "$value": "2px",  "$type": "spacing" },
    "4":  { "$value": "4px",  "$type": "spacing" },
    "8":  { "$value": "8px",  "$type": "spacing" },
    "12": { "$value": "12px", "$type": "spacing" },
    "16": { "$value": "16px", "$type": "spacing" },
    "20": { "$value": "20px", "$type": "spacing" },
    "24": { "$value": "24px", "$type": "spacing" },
    "32": { "$value": "32px", "$type": "spacing" },
    "40": { "$value": "40px", "$type": "spacing" },
    "48": { "$value": "48px", "$type": "spacing" }
  },
  "radius": {
    "sm":     { "$value": "8px",  "$type": "borderRadius" },
    "frame":  { "$value": "12px", "$type": "borderRadius", "$description": "Prefer chamfered/octagonal mask in Figma" },
    "panel":  { "$value": "14px", "$type": "borderRadius" },
    "pill":   { "$value": "999px", "$type": "borderRadius", "$description": "Status chips only" }
  },
  "borderWidth": {
    "hairline": { "$value": "1px", "$type": "borderWidth" },
    "active":   { "$value": "2px", "$type": "borderWidth" }
  },
  "opacity": {
    "irisBorder": { "$value": "0.32", "$type": "opacity" },
    "grid":       { "$value": "0.4",  "$type": "opacity" },
    "scanline":   { "$value": "0.05", "$type": "opacity" },
    "disabled":   { "$value": "0.28", "$type": "opacity" }
  },
  "shadow": {
    "device": {
      "$type": "boxShadow",
      "$value": { "x": "0", "y": "18", "blur": "50", "spread": "0", "color": "#0000008C" }
    },
    "focus": {
      "$type": "boxShadow",
      "$value": { "x": "0", "y": "0", "blur": "16", "spread": "0", "color": "#5CE1FF59" }
    }
  },
  "dimension": {
    "control.sm": { "$value": "36px", "$type": "dimension" },
    "control.md": { "$value": "40px", "$type": "dimension" },
    "control.lg": { "$value": "44px", "$type": "dimension" },
    "icon.sm":    { "$value": "16px", "$type": "dimension" },
    "icon.md":    { "$value": "20px", "$type": "dimension" },
    "statusDot":  { "$value": "8px", "$type": "dimension" },
    "statusSlit": { "$value": "16px", "$type": "dimension" }
  },
  "motion": {
    "duration": {
      "fast": { "$value": "160ms", "$type": "duration" },
      "med":  { "$value": "240ms", "$type": "duration" },
      "iris": { "$value": "16000ms", "$type": "duration" }
    },
    "easing": {
      "out": { "$value": "cubic-bezier(0.16, 1, 0.3, 1)", "$type": "cubicBezier" }
    }
  }
}