// Cloudflare Workers deployment, ported here from hubconnect's own standalone-shell repo.
//
// otchub's actual site is ONE Base44-published SPA (`npm run build` -> `./dist`, root `base`,
// client-side routing via src/hub/HubRoutes.tsx) that already serves `/hub`, `/devnet`, and
// `/drip` correctly on its own via Base44's git-sync/publish — there's no otchub `build:devnet`
// script, no per-mode Vite `base`, and no `dist-devnet` bundle (unlike hubconnect's own repo,
// which does build separate mainnet/devnet bundles for its standalone shell). So only ONE of the
// two environments below is meant to actually own live Cloudflare Worker Routes on otchub.dev:
//   - env.devnet     -> otchub.dev/api/faucet/* + otchub.dev/api/curve/*  (this Worker's real job
//                        here — the Solana-specific faucet/bonding-curve backend Base44 has no
//                        equivalent for; see workers/faucet.ts's routing comment)
//   - env.production -> otchub.dev/hub*  — NOT deployed, and shouldn't be as currently written:
//                        `workers/asset-router.ts` assumes a `/hub`-based Vite build (`base:
//                        "/hub/"`) that doesn't exist in this pipeline. Attaching this route
//                        would shadow otchub's already-working, Base44-published `/hub` page with
//                        an incompatible/stale bundle. Leave undeployed until that build pipeline
//                        is actually built, or drop the route entirely.
// The top-level config mirrors `env.production` purely so `wrangler dev`/other env-less commands
// still resolve to something sane — never deploy it bare either, for the same reason above.
//
// Deploy: `npx wrangler deploy --env devnet` (from this directory) — always pass `--env`
// explicitly (wrangler warns otherwise, since this file defines named environments).
{
  "name": "hubconnect-web",
  "compatibility_date": "2026-08-01",
  "main": "workers/asset-router.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash",
  },
  "routes": [{ "pattern": "otchub.dev/hub*", "zone_name": "otchub.dev" }],
  "observability": { "enabled": true },
  "env": {
    // Mainnet-beta — the only build ever served at otchub.dev/hub. Same Worker name as the
    // top-level default (deliberately) so `wrangler deploy` and `wrangler deploy --env
    // production` always resolve to one script, never two competing claims on the route.
    // `workers/asset-router.ts` strips the `/hub` mount prefix before delegating to
    // `env.ASSETS.fetch()` — see the top-of-file note on `vite.config.ts`'s `base`.
    "production": {
      "name": "hubconnect-web",
      "main": "workers/asset-router.ts",
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "html_handling": "auto-trailing-slash",
      },
      "routes": [{ "pattern": "otchub.dev/hub*", "zone_name": "otchub.dev" }],
      "observability": { "enabled": true },
    },
    // API-only Worker, same zone as otchub's own site (path-scoped routes below, not a Custom
    // Domain, so it coexists with otchub's own site without claiming the whole hostname).
    //
    // otchub builds ONE Base44-managed SPA (`npm run build` -> `./dist`, root `base`, client-side
    // routing via HubRoutes.tsx) that already serves `/hub`, `/devnet`, and `/drip` correctly on
    // its own — there is no separate `/devnet`-based Vite build or `dist-devnet` bundle in this
    // repo (that dual-bundle asset-serving model is hubconnect's own standalone-shell setup, not
    // otchub's). So this env's routes are scoped to ONLY the API surface this Worker actually
    // owns — `/api/faucet/*` + `/api/curve/*` (token drips + Mock OTC Desk minting, bonding curve
    // trades) — never `/devnet*`/`/drip*`: attaching those would shadow otchub's working,
    // already-published SPA pages with this Worker's nonexistent `dist-devnet` bundle. `main`
    // (workers/faucet.ts) still carries a static-asset fallback branch for non-`/api` paths, but
    // it's unreachable in practice since no such route is attached here; `assets.directory` below
    // points at otchub's real, already-built `dist` purely so wrangler has a valid directory to
    // satisfy that fallback if it's ever hit (e.g. `wrangler dev`), not because it's expected to
    // serve real devnet traffic. `nodejs_compat` is required for the Buffer usage in
    // @solana/web3.js + the faucet's raw instruction builders.
    "devnet": {
      "name": "hubconnect-web-devnet",
      "main": "workers/faucet.ts",
      "compatibility_flags": ["nodejs_compat"],
      "assets": {
        "directory": "../../dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "html_handling": "auto-trailing-slash",
      },
      "routes": [
        { "pattern": "otchub.dev/api/faucet/*", "zone_name": "otchub.dev" },
        { "pattern": "otchub.dev/api/curve/*", "zone_name": "otchub.dev" },
      ],
      "observability": { "enabled": true },
      // Cross-origin allowlist for every /api/faucet/* + /api/curve/* response (see
      // workers/cors.ts). Same-origin (no preflight needed at all) once otchub.dev's own site
      // links straight to otchub.dev/devnet + /drip — this stays purely as a fallback for
      // `wrangler dev`/local Vite (different port = different origin) and any preview deploy
      // (Base44, etc.) that calls this Worker cross-origin. Extend as needed; comma-separated,
      // no spaces required. workers/cors.ts falls back to this same list if the var is removed.
      "vars": {
        "ALLOWED_ORIGINS": "https://otchub.dev,https://www.otchub.dev,http://localhost:5173,http://localhost:3000",
      },
      // Rate-limit bucket for the faucet (per-wallet cooldowns + per-IP abuse guard). Created via
      // `wrangler kv namespace create FAUCET_KV --env devnet`; id filled in after creation.
      //
      // CURVE_KV is the bonding-curve simulation's own store (virtual reserves, trade log,
      // deposit-signature replay guard — see workers/bonding-curve.ts), isolated from the
      // faucet's rate-limit bucket. Created via `wrangler kv namespace create CURVE_KV --env devnet`.
      "kv_namespaces": [
        { "binding": "FAUCET_KV", "id": "877e6b420c51440d83e1a9fabfd6c0d4" },
        { "binding": "CURVE_KV", "id": "261211c9d7844bc0ac73a35223f8b808" },
      ],
      // HUB_RPC_URL is a `wrangler secret` (not a `vars` entry — Cloudflare rejects a secret and
      // a var sharing one binding name), set to a Helius devnet URL: the plain public
      // api.devnet.solana.com endpoint 403s Cloudflare Workers' egress IPs. faucet.ts falls back
      // to api.devnet.solana.com only when the secret is unset. Set/rotate with:
      //   wrangler secret put HUB_RPC_URL --env devnet
      //
      // CURVE_KEY is the curve treasury's own devnet keypair (JSON secret-key array), isolated
      // from FAUCET_KEY — holds the real ≥95% $HUB public float + collected SOL. Set with:
      //   wrangler secret put CURVE_KEY --env devnet
      //
      // TURNSTILE_SECRET_KEY gates /api/faucet/drip and /api/faucet/mint-desk behind a Cloudflare
      // Turnstile challenge (bot-abuse guard, independent of the IP/wallet cooldowns above).
      // Optional: verification is skipped when unset, so the faucet keeps working before it's
      // provisioned. Pair with VITE_TURNSTILE_SITE_KEY (web/.env.devnet(.local)) for the client
      // widget. Create a widget in the Cloudflare dash (Turnstile) pointed at otchub.dev, then:
      //   wrangler secret put TURNSTILE_SECRET_KEY --env devnet
    },
  },
}
