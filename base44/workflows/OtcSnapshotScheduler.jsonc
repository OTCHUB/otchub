{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "OTC Snapshot Scheduler",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "otc_snapshot_scheduler",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "snapshot": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "fetchOtcData",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Fetch OTC snapshot",
            "description": "On-chain + market data ingest"
          }
        }
      }
    ]
  },
  "description": "Ingests OTC protocol on-chain + market data into an OtcSnapshot every 5 minutes."
