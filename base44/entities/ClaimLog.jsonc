{
  "name": "ClaimLog",
  "type": "object",
  "properties": {
    "wallet": {
      "type": "string"
    },
    "asset_id": {
      "type": "string"
    },
    "symbol": {
      "type": "string"
    },
    "mint": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "value_usd": {
      "type": "number"
    },
    "value_sol": {
      "type": "number"
    },
    "tx_sig": {
      "type": "string"
    }
  },
  "required": [
    "wallet",
    "asset_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}