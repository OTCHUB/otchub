      "type": "string"
    },
    "desks": {
      "type": "integer"
    },
    "ixs": {
      "type": "integer"
    },
    "txs_sent": {
      "type": "integer"
    },
    "txs_failed": {
      "type": "integer"
    },
    "fees_sol": {
      "type": "number"
    },
    "backlog_sol_before": {
      "type": "number"
    },
    "cleared_sol": {
      "type": "number"
    },
    "cleared_usd": {
      "type": "number"
    },
    "cleared_by_stock": {
      "type": "object"
    },
    "keeper_balance_sol": {
      "type": "number"
    },
